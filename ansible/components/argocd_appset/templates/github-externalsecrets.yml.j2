# Secrets com o GitHub PAT, sincronizados do Bitwarden pelo External Secrets Operator.
# O {% raw %}{{ .token }}{% endraw %} é Go template do ESO, por isso fica dentro de raw/endraw.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: github-token-secret
  namespace: {{ argocd_appset_namespace }}
spec:
  refreshInterval: {{ github_token_refresh_interval }}
  secretStoreRef:
    kind: ClusterSecretStore
    name: bitwarden
  target:
    name: github-token-secret
    creationPolicy: Owner
  data:
    - secretKey: token
      remoteRef:
        key: {{ bitwarden_github_pat_secret_id }}
---
# Credencial de repositório (por prefixo de URL) para o ArgoCD puxar charts Helm OCI do GHCR.
# O token precisa de read:packages (o mesmo já usado pelo Image Updater no ghcr-creds).
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ghcr-helm-oci-creds
  namespace: {{ argocd_appset_namespace }}
spec:
  refreshInterval: {{ github_token_refresh_interval }}
  secretStoreRef:
    kind: ClusterSecretStore
    name: bitwarden
  target:
    name: ghcr-helm-oci-creds
    creationPolicy: Owner
    template:
      engineVersion: v2
      metadata:
        labels:
          argocd.argoproj.io/secret-type: repo-creds
      data:
        type: helm
        url: "ghcr.io/{{ github_org | lower }}"
        enableOCI: "true"
        username: "{{ github_user }}"
        password: "{% raw %}{{ .token }}{% endraw %}"
  data:
    - secretKey: token
      remoteRef:
        key: {{ bitwarden_github_pat_secret_id }}
