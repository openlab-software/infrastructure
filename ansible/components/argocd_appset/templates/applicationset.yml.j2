apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: github-org-autodiscover
  namespace: {{ argocd_appset_namespace }}
spec:
  goTemplate: true
  generators:
    - scmProvider:
        cloneProtocol: https
        github:
          organization: {{ github_org }}
          tokenRef:
            secretName: github-token-secret
            key: token
        filters:
          # Descoberta por conteúdo: tem .devops/k8s e NÃO tem .devops/helm (se houver chart, o
          # ApplicationSet abaixo assume). Os dois campos do mesmo filtro são combinados com AND.
          - pathsExist: [{{ k8s_path }}]
            pathsDoNotExist: [{{ helm_path }}]
  template:
    metadata:
      name: '{% raw %}{{- .repository -}}{% endraw %}'
      annotations:
        # Image Updater: imagem esperada em ghcr.io/<org>/<repo> (GHCR exige minúsculas), maior tag semver
        argocd-image-updater.argoproj.io/image-list: 'app=ghcr.io/{{ github_org | lower }}/{% raw %}{{ .repository | lower }}{% endraw %}'
        argocd-image-updater.argoproj.io/app.update-strategy: semver
        argocd-image-updater.argoproj.io/write-back-method: git:secret:{{ argocd_appset_namespace }}/git-creds
        argocd-image-updater.argoproj.io/git-branch: '{% raw %}{{ .branch }}{% endraw %}'
    spec:
      project: default
      source:
        repoURL: '{% raw %}{{- .url -}}{% endraw %}'
        targetRevision: '{% raw %}{{- .branch -}}{% endraw %}'
        path: {{ k8s_path }}
      destination:
        server: 'https://kubernetes.default.svc'
        namespace: '{% raw %}{{- .repository -}}{% endraw %}'
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
          - CreateNamespace=true
        # Re-tenta syncs que falharam (ex.: ExternalSecret ainda sem os secrets no Bitwarden)
        retry:
          limit: 2
          backoff:
            duration: 30s
            factor: 2
            maxDuration: 2m
---
# Repos com {{ helm_path }}: o ArgoCD segue o chart Helm publicado no GHCR (OCI).
# Sem Image Updater nem write-back no Git: a versão do chart (semver) é a fonte da tag da imagem.
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: github-org-autodiscover-helm
  namespace: {{ argocd_appset_namespace }}
spec:
  goTemplate: true
  generators:
    - scmProvider:
        cloneProtocol: https
        github:
          organization: {{ github_org }}
          tokenRef:
            secretName: github-token-secret
            key: token
        filters:
          - pathsExist: [{{ helm_path }}]
  template:
    metadata:
      name: '{% raw %}{{- .repository -}}{% endraw %}'
    spec:
      project: default
      source:
        # Sem o esquema oci://; o chart tem o mesmo nome do repositório (GHCR exige minúsculas)
        repoURL: {{ helm_chart_registry }}
        chart: '{% raw %}{{- .repository | lower -}}{% endraw %}'
        # Constraint semver: segue a maior versão publicada (pré-releases ficam de fora)
        targetRevision: '{{ helm_chart_revision }}'
      destination:
        server: 'https://kubernetes.default.svc'
        namespace: '{% raw %}{{- .repository -}}{% endraw %}'
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
          - CreateNamespace=true
        retry:
          limit: 2
          backoff:
            duration: 30s
            factor: 2
            maxDuration: 2m
