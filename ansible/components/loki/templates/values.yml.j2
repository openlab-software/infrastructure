# Loki monolítico (SingleBinary) com filesystem: simples e suficiente para homelab/dev.
deploymentMode: SingleBinary
loki:
  auth_enabled: false
  commonConfig:
    replication_factor: 1
  schemaConfig:
    configs:
      - from: "2024-04-01"
        store: tsdb
        object_store: filesystem
        schema: v13
        index:
          prefix: loki_index_
          period: 24h
  storage:
    type: filesystem
  limits_config:
    retention_period: {{ loki_retention }}
    allow_structured_metadata: true   # necessário para ingestão OTLP
  compactor:
    retention_enabled: true
    delete_request_store: filesystem
singleBinary:
  replicas: 1
  persistence:
    enabled: true
    size: {{ loki_storage_size }}
backend: { replicas: 0 }
read: { replicas: 0 }
write: { replicas: 0 }
gateway: { enabled: false }
chunksCache: { enabled: false }
resultsCache: { enabled: false }
lokiCanary: { enabled: false }
test: { enabled: false }
ruler: { enabled: false }
sidecar:
  rules: { enabled: false }
{% if 'monitoring' in (selected_components | default([])) %}
monitoring:
  serviceMonitor: { enabled: true }
  selfMonitoring: { enabled: false }
{% endif %}
