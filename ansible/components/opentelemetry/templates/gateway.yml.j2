{% set _sel = selected_components | default([]) %}
{% set _tempo = 'tempo' in _sel %}
{% set _loki = 'loki' in _sel %}
{% set _prom = 'monitoring' in _sel %}
# Gateway: recebe OTLP das aplicações (gRPC 4317 / HTTP 4318) e roteia cada sinal.
# Service criado pelo operator: otel-gateway-collector.{{ observability_namespace }}
apiVersion: opentelemetry.io/v1beta1
kind: OpenTelemetryCollector
metadata:
  name: otel-gateway
  namespace: {{ observability_namespace }}
spec:
  mode: deployment
  replicas: 1
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { memory: 512Mi }
{% if _prom %}
  observability:
    metrics:
      enableMetrics: true
{% endif %}
  config:
    receivers:
      otlp:
        protocols:
          grpc:
            endpoint: 0.0.0.0:4317
          http:
            endpoint: 0.0.0.0:4318
    processors:
      memory_limiter:
        check_interval: 1s
        limit_percentage: 75
        spike_limit_percentage: 20
      k8sattributes:
        extract:
          metadata:
            - k8s.namespace.name
            - k8s.pod.name
            - k8s.deployment.name
            - k8s.node.name
        pod_association:
          - sources:
              - from: resource_attribute
                name: k8s.pod.ip
          - sources:
              - from: connection
      batch: {}
    exporters:
      # Backend ausente (componente desligado): o sinal só aparece no log do coletor
      debug:
        verbosity: basic
{% if _tempo %}
      otlp/tempo:
        endpoint: tempo.{{ observability_namespace }}.svc.cluster.local:4317
        tls:
          insecure: true
{% endif %}
{% if _loki %}
      otlphttp/loki:
        endpoint: http://loki.{{ observability_namespace }}.svc.cluster.local:3100/otlp
{% endif %}
{% if _prom %}
      prometheusremotewrite:
        endpoint: http://{{ monitoring_release }}-kube-prometheus-prometheus.{{ monitoring_namespace }}.svc.cluster.local:9090/api/v1/write
{% endif %}
    service:
      pipelines:
        traces:
          receivers: [otlp]
          processors: [memory_limiter, k8sattributes, batch]
          exporters: [{{ 'otlp/tempo' if _tempo else 'debug' }}]
        metrics:
          receivers: [otlp]
          processors: [memory_limiter, k8sattributes, batch]
          exporters: [{{ 'prometheusremotewrite' if _prom else 'debug' }}]
        logs:
          receivers: [otlp]
          processors: [memory_limiter, k8sattributes, batch]
          exporters: [{{ 'otlphttp/loki' if _loki else 'debug' }}]
