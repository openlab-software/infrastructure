# Credencial do registry (user:token) e do git write-back (username/password),
# sincronizadas do Bitwarden pelo External Secrets Operator.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ghcr-creds
  namespace: {{ argocd_image_updater_namespace }}
spec:
  refreshInterval: {{ github_token_refresh_interval }}
  secretStoreRef:
    kind: ClusterSecretStore
    name: bitwarden
  target:
    name: ghcr-creds
    creationPolicy: Owner
    template:
      engineVersion: v2
      data:
        creds: "{{ github_user }}:{% raw %}{{ .token }}{% endraw %}"
  data:
    - secretKey: token
      remoteRef:
        key: {{ bitwarden_github_pat_secret_id }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: git-creds
  namespace: {{ argocd_image_updater_namespace }}
spec:
  refreshInterval: {{ github_token_refresh_interval }}
  secretStoreRef:
    kind: ClusterSecretStore
    name: bitwarden
  target:
    name: git-creds
    creationPolicy: Owner
    template:
      engineVersion: v2
      data:
        username: "{{ github_user }}"
        password: "{% raw %}{{ .token }}{% endraw %}"
  data:
    - secretKey: token
      remoteRef:
        key: {{ bitwarden_github_pat_secret_id }}
